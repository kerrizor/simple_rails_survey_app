<h1>New Survey</h1>

<%= form_with model: @survey do |form| %>
  <% if @survey.errors.any? %>
    <div role="alert">
      <p>Sorry, your survey couldn't be saved. Please fix the following:</p>
      <ul>
        <% @survey.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :question %>
    <%= form.text_field :question %>
  </div>

  <%= form.submit "Create Survey" %>
<% end %>

<%= link_to "Back", root_path %>
